[agent]
  log_level = "info"

[sources.mcp_logs]
type = "file"
include = ["/var/log/hermes/mcp.log"]
read_from = "beginning"
glob_interval_seconds = 1

[transforms.parse_mcp]
type = "remap"
inputs = ["mcp_logs"]
source = """
. = parse_json!(.message)
. timestamp = .asctime
. level = downcase!(.levelname)
. logger = .name
. service = "proxmox-mcp"
. component = "mcp-server"
. host = get_env_var("HOSTNAME") ?? "unknown"
. trace_id = .trace_id ?? uuid_v4()
del(.asctime, .levelname, .name)
"""

[sinks.loki_mcp]
type = "loki"
inputs = ["parse_mcp"]
endpoint = "http://${LOKI_HOST}:3100"
labels = {
  env = "${ENV}",
  service = "{{ service }}",
  component = "{{ component }}",
  host = "{{ host }}",
  status = "{{ status }}",
}
label_keys = ["service", "component", "host", "level", "status", "mcp_tool_name"]
request.concurrency = 5
compression = "gzip"
healthcheck.enabled = true

[sinks.loki_mcp.buffer]
type = "disk"
max_size = 2147483648
when_full = "block"
