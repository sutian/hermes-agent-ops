[data_dir] = "/var/lib/vector"

[api]
  enabled = true
  address = "127.0.0.1:9002"

[sources.mcp_log]
  type = "file"
  include = ["/var/log/hermes/mcp.log"]
  read_from = "end"
  file_key = "file"
  ignore_older = 86400

[transforms.parse_mcp_json]
  type = "remap"
  inputs = ["mcp_log"]
  source = '''
    . = parse_json!(string!(.message)) ?? {}
    .timestamp = .timestamp ?? now()
    .host = get_env_var!("HOSTNAME") ?? "unknown"
    .service = "mcp"
    .component = "${COMPONENT}"
  '''

[transforms.add_mcp_labels]
  type = "remap"
  inputs = ["parse_mcp_json"]
  source = '''
    .tags = {
      "component": .component,
      "host": .host,
      "service": "mcp",
      "status": .status ?? "unknown"
    }
  '''

[sinks.loki_mcp]
  type = "loki"
  inputs = ["add_mcp_labels"]
  endpoint = "http://${LOKI_HOST}:3100"
  encoding.codec = "json"
  compression = "gzip"
  labels = {
    service = "mcp",
    component = "{{component}}",
    host = "{{host}}",
    status = "{{status}}"
  }

  [sinks.loki_mcp.request]
    batch_size = 1024
    batch_timeout = "1s"
    concurrency = 10

  [sinks.loki_mcp.buffer]
    type = "disk"
    max_size = 5368704000
    when_full = "block"
    num_shards = 4

  [sinks.loki_mcp.tls]
    verify = false

[sinks.prometheus_mcp]
  type = "prometheus_exporter"
  inputs = ["mcp_log"]
  address = "127.0.0.1:9091"

  [sinks.prometheus_mcp.namespace] = "vector_mcp"
