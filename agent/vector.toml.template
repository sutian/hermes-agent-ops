[data_dir] = "/var/lib/vector"

[api]
  enabled = true
  address = "127.0.0.1:9001"

[sources.hermes_agent_log]
  type = "file"
  include = ["/var/log/hermes/agent.log"]
  read_from = "end"
  file_key = "file"
  ignore_older = 86400

[transforms.parse_hermes_json]
  type = "remap"
  inputs = ["hermes_agent_log"]
  source = '''
    . = parse_json!(string!(.message)) ?? {}
    .timestamp = .timestamp ?? now()
    .host = get_env_var!("HOSTNAME") ?? "unknown"
    .agent_id = "${AGENT_ID}"
    .platform = "${PLATFORM}"
    .service = "hermes-agent"
  '''

[transforms.add_loki_labels]
  type = "remap"
  inputs = ["parse_hermes_json"]
  source = '''
    .tags = {
      "agent_id": .agent_id,
      "host": .host,
      "platform": .platform,
      "service": "hermes-agent",
      "level": .level ?? "info"
    }
  '''

[sinks.loki]
  type = "loki"
  inputs = ["add_loki_labels"]
  endpoint = "http://${LOKI_HOST}:3100"
  encoding.codec = "json"
  compression = "gzip"
  labels = {
    service = "hermes-agent",
    host = "{{host}}",
    agent_id = "{{agent_id}}",
    platform = "{{platform}}",
    level = "{{level}}"
  }

  [sinks.loki.request]
    batch_size = 1024
    batch_timeout = "1s"
    concurrency = 10
    rate_limit_duration = "1s"
    rate_limit_num = 1000

  [sinks.loki.buffer]
    type = "disk"
    max_size = 5368704000
    when_full = "block"
    num_shards = 4

  [sinks.loki.tls]
    verify = false

[sinks.prometheus]
  type = "prometheus_exporter"
  inputs = ["hermes_agent_log"]
  address = "127.0.0.1:9090"

  [sinks.prometheus.namespace] = "vector"
  [sinks.prometheus.sinks_input]
    events_received_total = "events_received_total"
    events_outdoors_total = "events_out_total"
    buffer_byte_size = "buffer_byte_size"
