[Unit]
Description=Vector log agent for MCP servers
Documentation=https://github.com/sutian/hermes-agent-ops
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vector
Group=vector
ExecStart=/usr/local/bin/vector --config /etc/vector/mcp-vector.toml
Environment=VECTOR_CONFIG=/etc/vector/mcp-vector.toml
Restart=always
RestartSec=5
TimeoutStopSec=30
LimitNOFILE=65536

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/vector,/var/log/hermes
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

StandardOutput=null
StandardError=journal
SyslogIdentifier=mcp-vector-agent

[Install]
WantedBy=multi-user.target
