# hermes-agent-ops environment variables
# Copy to .env and fill in real values

# === Log Server ===
LOG_SERVER_HOST=192.168.1.12
LOKI_HTTP_PORT=3100
LOKI_GRPC_PORT=9096

# === Grafana ===
GRAFANA_ADMIN_PASSWORD=change_me_in_production
GRAFANA_PORT=3001

# === Prometheus ===
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_DAYS=15

# === Loki Retention ===
LOKI_RETENTION_DAYS=30

# === Vector Agent ===
# Comma-separated list of hermes hosts
HERMES_HOSTS=192.168.1.11
AGENT_ID=main
PLATFORM=telegram

# === Secrets (production) ===
# DOCKERHUB_USERNAME=your_username
# DOCKERHUB_TOKEN=your_token
# VAULT_ADDR=https://vault.internal:8200

# === TLS Certificates (Phase 2+) ===
# LOKI_TLS_CERT_PATH=/etc/loki/tls/cert.pem
# LOKI_TLS_KEY_PATH=/etc/loki/tls/key.pem
# LOKI_TLS_CA_PATH=/etc/loki/tls/ca.pem
