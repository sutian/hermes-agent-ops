# hermes-agent-ops environment variables
# Copy to .env and fill in real values

# =====================
# LOG SERVER
# =====================

# Grafana admin password (change this!)
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_strong_password_here

# =====================
# VECTOR AGENT
# =====================

# Loki host (IP or hostname of log server)
LOKI_HOST=CHANGE_ME_log_server_ip

# Environment label
ENV=production

# =====================
# PROMETHEUS (optional)
# =====================

# Alertmanager webhook for alerts
ALERTMANAGER_WEBHOOK=

# =====================
# SECURITY (future)
# =====================

# For mTLS / certificate-based auth
# LOKI_CA_PATH=/etc/ssl/certs/loki-ca.crt
# LOKI_CLIENT_CERT_PATH=/etc/ssl/private/loki-client.crt
# LOKI_CLIENT_KEY_PATH=/etc/ssl/private/loki-client.key

# Vault / secret manager integration (future)
# VAULT_ADDR=https://vault.internal:8200
